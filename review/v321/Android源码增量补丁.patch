+++ b/app/src/main/java/com/leo/jiarentong/FamilyAttentionV321.kt
@@ -0,0 +1,31 @@
+package com.leo.jiarentong
+
+import android.content.Context
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+
+/** 角标规则：本人成员/未分配待办、未采购、本月未结束日程；其余仍用未读消息。 */
+internal fun attentionCountV321(rows:List<CollabRecord>,family:String,memberUid:String,now:Long=System.currentTimeMillis()):Int {
+    val month=collabFormat("yyyy-MM").format(java.util.Date(now))
+    return rows.filter{it.familyId==family && !it.deleted}.distinctBy{it.id}.count{r->
+        val f=r.fields
+        attentionEligibleV321(r.module,f.optBoolean("completed"),f.optString("assigneeUid"),memberUid,f.optString("date"),f.optString("endTime"),month,now)
+    }
+}
+internal fun attentionEligibleV321(module:CollabModule,completed:Boolean,assignee:String,memberUid:String,date:String,end:String,month:String,now:Long):Boolean=when(module){
+    CollabModule.TODO -> !completed && (assignee.isBlank()||assignee==memberUid)
+    CollabModule.SHOPPING -> !completed
+    CollabModule.SCHEDULE -> date.take(7)==month && collabEventAt(date,end.ifBlank{"23:59"})>now
+    else -> false
+}
+internal suspend fun loadAttentionV321(context:Context,uid:String,family:String,memberUid:String):Map<String,Int>{
+    val repo=FamilyCollabRepository.get(context);val now=System.currentTimeMillis()
+    val month=collabFormat("yyyy-MM").format(java.util.Date(now));val counts=mutableMapOf<String,Int>()
+    for(module in listOf(CollabModule.TODO,CollabModule.SCHEDULE,CollabModule.SHOPPING)){
+        currentCoroutineContext().ensureActive()
+        val page=repo.records(uid,family,module,month)
+        if(!page.complete)throw CloudFailure("超过完整统计范围，角标暂不显示，请进入板块查看",code="partial")
+        counts[module.key]=attentionCountV321(page.records,family,memberUid,now)
+    }
+    return counts
+}
